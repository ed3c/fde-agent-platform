{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ed3c.github.io/fde-agent-platform/contracts/registry-entry.schema.json",
  "title": "FDE Agent Registry Entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "registry_entry_id", "artifact_type", "logical_id", "version", "contract_id", "content_digest", "authority_ceiling_digest", "state", "created_at", "supersedes", "private_reference", "source_subjects", "validation_receipt_digest"],
  "properties": {
    "schema": { "const": "fde-agent/registry-entry/v1" },
    "registry_entry_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,95}$" },
    "artifact_type": { "enum": ["ROLE_PACK", "TENANT_OVERLAY_REFERENCE", "OUTCOME_CONTRACT", "DIGITAL_EMPLOYEE_SPEC"] },
    "logical_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,95}$" },
    "version": { "type": "string", "pattern": "^\d+\.\d+\.\d+(?:-[0-9A-Za-z.-]+)?$" },
    "contract_id": { "type": "string", "minLength": 1 },
    "content_digest": { "$ref": "#/$defs/digest" },
    "authority_ceiling_digest": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
    "state": { "enum": ["DRAFT", "VALIDATED", "ACTIVE", "SUPERSEDED", "REVOKED"] },
    "created_at": { "type": "string", "format": "date-time" },
    "supersedes": { "type": ["string", "null"] },
    "private_reference": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tenant_id", "resolver_profile", "artifact_digest", "expires_at"],
          "properties": {
            "tenant_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,95}$" },
            "resolver_profile": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,95}$" },
            "artifact_digest": { "$ref": "#/$defs/digest" },
            "expires_at": { "type": "string", "format": "date-time" }
          }
        }
      ]
    },
    "source_subjects": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "validation_receipt_digest": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
