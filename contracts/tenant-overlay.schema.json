{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ed3c.dev/fde-agent/tenant-overlay/v1",
  "title": "FDE Agent Tenant Overlay",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "tenant_id",
    "role_pack_ref",
    "systems",
    "enabled_actions",
    "human_manager_role",
    "escalation_roles",
    "model_profile_id",
    "privacy",
    "outcome_contract_id"
  ],
  "properties": {
    "schema": { "const": "fde-agent/tenant-overlay/v1" },
    "tenant_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "role_pack_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role_pack_id", "version"],
      "properties": {
        "role_pack_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "systems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["system_id", "connector_id", "granted_capabilities"],
        "properties": {
          "system_id": { "type": "string", "minLength": 1 },
          "connector_id": { "type": "string", "minLength": 1 },
          "granted_capabilities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "enabled_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action_id"],
        "properties": {
          "action_id": { "type": "string", "minLength": 1 },
          "approval_role": { "type": "string", "minLength": 1 }
        }
      }
    },
    "human_manager_role": { "type": "string", "minLength": 1 },
    "escalation_roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "model_profile_id": { "type": "string", "minLength": 1 },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data_classification", "zero_data_retention_required", "allowed_regions"],
      "properties": {
        "data_classification": {
          "enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"]
        },
        "zero_data_retention_required": { "type": "boolean" },
        "allowed_regions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "outcome_contract_id": { "type": "string", "minLength": 1 }
  }
}
