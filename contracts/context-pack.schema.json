{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fde-agent-platform.dev/contracts/context-pack/v1",
  "title": "ContextPack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "context_pack_id", "tenant_ref", "task_subject", "process_twin_digest",
    "query_digest", "state", "selected_nodes", "selected_claims", "unresolved_contradictions",
    "omitted_optional_nodes", "mandatory_policy_subjects", "budget", "authority_envelope",
    "refusal_reasons", "context_digest", "execution_authority"
  ],
  "properties": {
    "schema": { "const": "fde-agent/context-pack/v1" },
    "context_pack_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,95}$" },
    "tenant_ref": { "type": "string", "minLength": 1 },
    "task_subject": { "type": "string", "minLength": 1 },
    "process_twin_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "query_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "state": { "enum": ["READY", "DEGRADED", "REFUSED"] },
    "selected_nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "view", "owner_role", "source_claim_ids", "estimated_tokens", "reason"],
        "properties": {
          "node_id": { "type": "string", "minLength": 1 },
          "view": { "enum": ["DOCUMENTED", "OBSERVED", "SYSTEM_ENFORCED", "APPROVED_TARGET"] },
          "owner_role": { "type": "string", "minLength": 1 },
          "source_claim_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "estimated_tokens": { "type": "integer", "minimum": 1 },
          "reason": { "enum": ["REQUIRED", "DEPENDENCY", "OPTIONAL"] }
        }
      }
    },
    "selected_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "claim_digest", "source_id", "recorded_at", "valid_from", "valid_to", "data_classification", "readiness_state"],
        "properties": {
          "claim_id": { "type": "string", "minLength": 1 },
          "claim_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "source_id": { "type": "string", "minLength": 1 },
          "recorded_at": { "type": "string", "format": "date-time" },
          "valid_from": { "type": "string", "format": "date-time" },
          "valid_to": { "type": ["string", "null"] },
          "data_classification": { "enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"] },
          "readiness_state": { "enum": ["READY", "DEGRADED"] }
        }
      }
    },
    "unresolved_contradictions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contradiction_id", "claim_ids", "subject_id", "predicate"],
        "properties": {
          "contradiction_id": { "type": "string", "minLength": 1 },
          "claim_ids": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "subject_id": { "type": "string", "minLength": 1 },
          "predicate": { "type": "string", "minLength": 1 }
        }
      }
    },
    "omitted_optional_nodes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "mandatory_policy_subjects": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_nodes", "used_nodes", "max_tokens", "used_tokens"],
      "properties": {
        "max_nodes": { "type": "integer", "minimum": 1 },
        "used_nodes": { "type": "integer", "minimum": 0 },
        "max_tokens": { "type": "integer", "minimum": 1 },
        "used_tokens": { "type": "integer", "minimum": 0 }
      }
    },
    "authority_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "tenant_ref", "maximum_data_classification"],
      "properties": {
        "purpose": { "const": "CONTEXT_ONLY" },
        "tenant_ref": { "type": "string", "minLength": 1 },
        "maximum_data_classification": { "enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"] }
      }
    },
    "refusal_reasons": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "context_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "execution_authority": { "const": "NONE" }
  }
}
