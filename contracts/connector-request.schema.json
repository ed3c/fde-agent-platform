    "security_invocation_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"security_decision_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"capability_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
