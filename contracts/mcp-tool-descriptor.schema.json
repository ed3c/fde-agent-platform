{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://fde-agent-platform.dev/contracts/mcp-tool-descriptor/v1",
  "title":"McpToolDescriptor","type":"object","additionalProperties":false,
