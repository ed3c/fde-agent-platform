{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ed3c.dev/fde-agent/outcome-contract/v1",
  "title": "FDE Outcome Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "outcome_contract_id",
    "tenant_id",
    "role_pack_id",
    "baseline_period",
    "measurement_window",
    "metrics",
    "attribution",
    "kill_criteria"
  ],
  "properties": {
    "schema": { "const": "fde-agent/outcome-contract/v1" },
    "outcome_contract_id": { "type": "string", "minLength": 1 },
    "tenant_id": { "type": "string", "minLength": 1 },
    "role_pack_id": { "type": "string", "minLength": 1 },
    "baseline_period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "format": "date" },
        "end": { "type": "string", "format": "date" }
      }
    },
    "measurement_window": { "type": "string", "minLength": 1 },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric_id", "unit", "direction", "baseline", "target", "source_of_truth"],
        "properties": {
          "metric_id": { "type": "string", "minLength": 1 },
          "unit": { "type": "string", "minLength": 1 },
          "direction": { "enum": ["INCREASE", "DECREASE", "HOLD"] },
          "baseline": { "type": "number" },
          "target": { "type": "number" },
          "source_of_truth": { "type": "string", "minLength": 1 }
        }
      }
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "external_factor_policy", "dispute_owner_role"],
      "properties": {
        "method": { "enum": ["A_B_TEST", "MATCHED_CONTROL", "TIME_SERIES", "BEFORE_AFTER_WITH_ADJUSTMENT"] },
        "external_factor_policy": { "type": "string", "minLength": 1 },
        "dispute_owner_role": { "type": "string", "minLength": 1 }
      }
    },
    "kill_criteria": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
