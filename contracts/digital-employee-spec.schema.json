{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ed3c.dev/fde-agent/digital-employee-spec/v1",
  "title": "Compiled Digital Employee Specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "spec_id",
    "state",
    "role_pack_ref",
    "tenant_id",
    "source_digests",
    "outcome_contract_id",
    "outcomes",
    "systems",
    "authority",
    "human_manager_role",
    "escalation_roles",
    "model_policy",
    "evals",
    "production_admission"
  ],
  "properties": {
    "schema": { "const": "fde-agent/digital-employee-spec/v1" },
    "spec_id": { "type": "string", "minLength": 1 },
    "state": { "const": "COMPILED" },
    "role_pack_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role_pack_id", "version"],
      "properties": {
        "role_pack_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "tenant_id": { "type": "string", "minLength": 1 },
    "source_digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role_pack_sha256", "tenant_overlay_sha256"],
      "properties": {
        "role_pack_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "tenant_overlay_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "outcome_contract_id": { "type": "string", "minLength": 1 },
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/outcome" }
    },
    "systems": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/systemBinding" }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled_actions", "prohibited_actions"],
      "properties": {
        "enabled_actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/effectiveAction" }
        },
        "prohibited_actions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "human_manager_role": { "type": "string", "minLength": 1 },
    "escalation_roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "model_policy": { "$ref": "#/$defs/modelPolicy" },
    "evals": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/eval" }
    },
    "production_admission": { "const": "HUMAN_ADMIT_REQUIRED" }
  },
  "$defs": {
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome_id", "description", "metric_ids"],
      "properties": {
        "outcome_id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "metric_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "systemBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system_id", "connector_id", "granted_capabilities"],
      "properties": {
        "system_id": { "type": "string", "minLength": 1 },
        "connector_id": { "type": "string", "minLength": 1 },
        "granted_capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "effectiveAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "system_id",
        "capability",
        "authority_level",
        "approval",
        "reversible"
      ],
      "properties": {
        "action_id": { "type": "string", "minLength": 1 },
        "system_id": { "type": "string", "minLength": 1 },
        "capability": { "type": "string", "minLength": 1 },
        "authority_level": { "enum": ["A0", "A1", "A2", "A3", "A4", "A5"] },
        "approval": { "enum": ["NEVER", "CONDITIONAL", "ALWAYS"] },
        "approval_role": { "type": "string", "minLength": 1 },
        "reversible": { "type": "boolean" }
      }
    },
    "modelPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "purpose",
        "data_classification",
        "zero_data_retention_required",
        "allowed_regions",
        "max_cost_per_call",
        "max_latency_ms"
      ],
      "properties": {
        "profile_id": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "data_classification": {
          "enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"]
        },
        "zero_data_retention_required": { "type": "boolean" },
        "allowed_regions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "max_cost_per_call": { "type": "number", "minimum": 0 },
        "max_latency_ms": { "type": "integer", "minimum": 1 }
      }
    },
    "eval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eval_id", "description", "blocking"],
      "properties": {
        "eval_id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "blocking": { "type": "boolean" }
      }
    }
  }
}
