{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ed3c.github.io/fde-agent-platform/contracts/eval-pack.schema.json",
  "title": "FDE Eval Pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "eval_pack_id", "version", "layer", "state", "subject_contracts", "case_ids", "release_thresholds", "model_judge_policy", "source_subjects"],
  "properties": {
    "schema": { "const": "fde-agent/eval-pack/v1" },
    "eval_pack_id": { "type": "string" },
    "version": { "type": "string" },
    "layer": { "enum": ["EVIDENCE", "PROCESS", "CONTEXT", "WORKFLOW", "POLICY", "CONNECTOR", "RUNTIME", "SECURITY", "MODEL", "OUTCOME", "ARCHITECTURE"] },
    "state": { "enum": ["DRAFT", "VALIDATED", "ACTIVE", "SUPERSEDED"] },
    "subject_contracts": { "type": "array", "minItems": 1, "uniqueItems": true },
    "case_ids": { "type": "array", "minItems": 1, "uniqueItems": true },
    "release_thresholds": { "type": "object" },
    "model_judge_policy": { "type": "object" },
    "source_subjects": { "type": "array", "minItems": 1, "uniqueItems": true }
  }
}
