{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ed3c.dev/fde-agent/role-pack/v1",
  "title": "FDE Agent Role Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "role_pack_id",
    "version",
    "title",
    "description",
    "human_manager_role",
    "outcomes",
    "systems",
    "actions",
    "prohibited_actions",
    "model_profiles",
    "evals",
    "required_escalation_roles"
  ],
  "properties": {
    "schema": { "const": "fde-agent/role-pack/v1" },
    "role_pack_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "human_manager_role": { "type": "string", "minLength": 1 },
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/outcome" }
    },
    "systems": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/system" }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/action" }
    },
    "prohibited_actions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "model_profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/modelProfile" }
    },
    "evals": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/eval" }
    },
    "required_escalation_roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome_id", "description", "metric_ids"],
      "properties": {
        "outcome_id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "metric_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system_id", "required_capabilities"],
      "properties": {
        "system_id": { "type": "string", "minLength": 1 },
        "required_capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "system_id",
        "capability",
        "authority_level",
        "approval",
        "reversible"
      ],
      "properties": {
        "action_id": { "type": "string", "minLength": 1 },
        "system_id": { "type": "string", "minLength": 1 },
        "capability": { "type": "string", "minLength": 1 },
        "authority_level": { "enum": ["A0", "A1", "A2", "A3", "A4", "A5"] },
        "approval": { "enum": ["NEVER", "CONDITIONAL", "ALWAYS"] },
        "required_approver_role": { "type": "string", "minLength": 1 },
        "reversible": { "type": "boolean" }
      }
    },
    "modelProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "purpose",
        "maximum_data_classification",
        "zero_data_retention_required",
        "allowed_regions",
        "max_cost_per_call",
        "max_latency_ms"
      ],
      "properties": {
        "profile_id": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "maximum_data_classification": {
          "enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"]
        },
        "zero_data_retention_required": { "type": "boolean" },
        "allowed_regions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "max_cost_per_call": { "type": "number", "minimum": 0 },
        "max_latency_ms": { "type": "integer", "minimum": 1 }
      }
    },
    "eval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eval_id", "description", "blocking"],
      "properties": {
        "eval_id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "blocking": { "type": "boolean" }
      }
    }
  }
}
