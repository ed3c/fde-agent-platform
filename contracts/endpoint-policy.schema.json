{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://fde-agent-platform.dev/contracts/endpoint-policy/v1",
  "title":"EndpointPolicy",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","endpoint_policy_id","connector_id","allowed_endpoint_refs","allowed_audiences","allowed_regions","maximum_data_classification","deny_private_network_targets","policy_digest"],
  "properties":{
    "schema":{"const":"fde-agent/endpoint-policy/v1"},"endpoint_policy_id":{"type":"string"},"connector_id":{"type":"string"},
    "allowed_endpoint_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
    "allowed_audiences":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
    "allowed_regions":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
    "maximum_data_classification":{"enum":["PUBLIC","INTERNAL","CONFIDENTIAL","RESTRICTED"]},
    "deny_private_network_targets":{"type":"boolean"},"policy_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"}
  }
}
